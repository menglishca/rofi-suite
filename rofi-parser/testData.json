{
    "menus": {
        "volume": {
            "prompt": {
                "message": "Volume",
                "icon": ""
            },
            "type": "applet",
            "theme": "bordered",
            "color": "nord",
            "message": "Speaker: $(amixer get Master | tail -n1 | awk -F ' ' '{print $5}' | tr -d '[]'), Mic: $(amixer get Capture | tail -n1 | awk -F ' ' '{print $5}' | tr -d '[]')",
            "options": [
                {
                    "label": {
                        "message": "Increase",
                        "icon": ""
                    },
                    "command": "amixer -Mq set Master,0 5%+ unmute"
                },
                {
                    "label": {
                        "message": "$(amixer get Master | grep -q '\\[on\\]' && echo 'Unmute' || echo 'Mute')",
                        "icon": "$(amixer get Master | grep -q '\\[on\\]' && echo '' || echo '')"
                    },
                    "command": "amixer set Master toggle"
                },
                {
                    "label": {
                        "message": "Decrease",
                        "icon": ""
                    },
                    "command": "amixer -Mq set Master,0 5%- unmute"
                },
                {
                    "label": {
                        "message": "$(amixer get Capture | grep -q '\\[on\\]' && echo 'Unmute' || echo 'Mute')",
                        "icon": "$(amixer get Capture | grep -q '\\[on\\]' && echo '' || echo '')"
                    },
                    "command": "amixer set Capture toggle"
                },
                {
                    "label": {
                        "message": "Settings",
                        "icon": ""
                    },
                    "command": "pavucontrol"
                }
            ]
        }
    }
}